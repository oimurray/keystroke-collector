{
  "manifest_version": 3,
  "name": "Keystroke Collector",
  "version": "1.0.0",
  "description": "Records key press/release timings in LLM chat boxes for a keystroke-dynamics study.",
  "permissions": ["storage", "unlimitedStorage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Keystroke Collector" },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://chat.mistral.ai/*"
      ],
      "js": ["common.js", "recorder.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
